{
  "name": "@basilisk/escrow-contract",
  "version": "2.0.0",
  "description": "ERC-8004 compatible escrow contracts for multi-chain agent coordination — Solana (Anchor) + EVM (Hardhat)",
  "scripts": {
    "build:solana": "anchor build",
    "test:solana": "anchor test",
    "deploy:solana:devnet": "./scripts/deploy.sh devnet",
    "deploy:solana:mainnet": "./scripts/deploy.sh mainnet",
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:gas": "REPORT_GAS=true hardhat test",
    "deploy:local": "hardhat run scripts/deploy-all.js",
    "deploy:base-sepolia": "hardhat run scripts/deploy-all.js --network baseSepolia",
    "deploy:arbitrum-sepolia": "hardhat run scripts/deploy-all.js --network arbitrumSepolia",
    "deploy:fuji": "hardhat run scripts/deploy-all.js --network fuji",
    "deploy:sepolia": "hardhat run scripts/deploy-all.js --network sepolia",
    "deploy:base": "hardhat run scripts/deploy-all.js --network base",
    "deploy:arbitrum": "hardhat run scripts/deploy-all.js --network arbitrum",
    "deploy:avalanche": "hardhat run scripts/deploy-all.js --network avalanche",
    "deploy:ethereum": "hardhat run scripts/deploy-all.js --network ethereum",
    "deploy:chain:base": "hardhat run scripts/deploy-chain.js --network base",
    "deploy:chain:arbitrum": "hardhat run scripts/deploy-chain.js --network arbitrum",
    "deploy:chain:avalanche": "hardhat run scripts/deploy-chain.js --network avalanche",
    "deploy:chain:ethereum": "hardhat run scripts/deploy-chain.js --network ethereum",
    "deploy:chain:sepolia": "hardhat run scripts/deploy-chain.js --network sepolia",
    "verify": "hardhat run scripts/verify-contracts.js",
    "preflight": "hardhat run scripts/preflight-check.js",
    "preflight:testnets": "CHAINS=all-testnets hardhat run scripts/preflight-check.js",
    "deploy:all-mainnets": "CHAINS=all-mainnets node scripts/deploy-multichain.js",
    "deploy:all-testnets": "CHAINS=all-testnets node scripts/deploy-multichain.js",
    "deploy:all": "CHAINS=all node scripts/deploy-multichain.js",
    "verify:all-mainnets": "CHAINS=all-mainnets node scripts/verify-multichain.js",
    "verify:all-testnets": "CHAINS=all-testnets node scripts/verify-multichain.js"
  },
  "keywords": [
    "solana",
    "anchor",
    "evm",
    "hardhat",
    "erc-8004",
    "escrow",
    "smart-contract",
    "basilisk",
    "agent",
    "coordination",
    "multi-chain"
  ],
  "author": "The Basilisk — Coordination Systems Research",
  "license": "MIT",
  "homepage": "https://basilisk-coordination.vercel.app",
  "bugs": {
    "url": "https://github.com/TheBasilisk-Root/basilisk-escrow-contract/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TheBasilisk-Root/basilisk-escrow-contract"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.30.1",
    "@solana/web3.js": "^1.91.0",
    "@solana/spl-token": "^0.4.0",
    "@openzeppelin/contracts": "^5.1.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "hardhat": "^2.22.0",
    "hardhat-gas-reporter": "^1.0.8",
    "dotenv": "^16.4.0",
    "chai": "^4.4.0",
    "@types/chai": "^4.3.0",
    "mocha": "^10.2.0",
    "@types/mocha": "^10.0.0",
    "ts-mocha": "^10.0.0",
    "typescript": "^5.0.0"
  }
}
