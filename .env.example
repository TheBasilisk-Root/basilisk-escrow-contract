# ============================================================================
# Basilisk Escrow Contract — Environment Variables
# ============================================================================
# Copy to .env and fill in values before deploying.

# ── Deployer Private Key ──
# Same key deploys to all chains. Must have native tokens on each target chain.
# Gas estimates: ETH mainnet ~0.15 ETH, Base ~0.005 ETH, Arbitrum ~0.008 ETH, Avalanche ~3 AVAX
DEPLOYER_PRIVATE_KEY=0x...your_private_key_here

# ── Contract Config ──
# These addresses receive platform fees. Use a multisig for production.
ARBITRATOR_ADDRESS=0x...
TREASURY_ADDRESS=0x...
OPS_WALLET_ADDRESS=0x...

# ── RPC URLs (Mainnets) ──
ETHEREUM_RPC_URL=https://eth.llamarpc.com
BASE_RPC_URL=https://mainnet.base.org
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
AVALANCHE_RPC_URL=https://api.avax.network/ext/bc/C/rpc

# ── RPC URLs (Testnets) ──
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc

# ── Explorer API Keys (for contract verification) ──
# Get keys: etherscan.io, basescan.org, arbiscan.io, snowtrace.io
ETHERSCAN_API_KEY=
BASESCAN_API_KEY=
ARBISCAN_API_KEY=
SNOWTRACE_API_KEY=

# ── Gas Reporting ──
REPORT_GAS=false
