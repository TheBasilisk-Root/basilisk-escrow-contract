# ============================================================================
# Basilisk Escrow Contract — Environment Variables
# ============================================================================

# ── Deployer ──
DEPLOYER_PRIVATE_KEY=0x...your_private_key_here

# ── RPC URLs (Mainnets) ──
ETHEREUM_RPC_URL=https://eth.llamarpc.com
BASE_RPC_URL=https://mainnet.base.org
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
AVALANCHE_RPC_URL=https://api.avax.network/ext/bc/C/rpc

# ── RPC URLs (Testnets) ──
SEPOLIA_RPC_URL=https://rpc.sepolia.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc

# ── Explorer API Keys (for contract verification) ──
ETHERSCAN_API_KEY=
BASESCAN_API_KEY=
ARBISCAN_API_KEY=
SNOWTRACE_API_KEY=

# ── Contract Config (per-chain, used by deploy scripts) ──
ARBITRATOR_ADDRESS=0x...
TREASURY_ADDRESS=0x...
OPS_WALLET_ADDRESS=0x...

# ── Gas Reporting ──
REPORT_GAS=false
